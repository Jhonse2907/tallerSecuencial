Algoritmo converUnid
	Definir cen, yar, me, pie, pul Como Real
	Escribir "Ingrese el valor a convertir en centrimetros"
	Leer cen
	yar=cen/91.44
	me=cen/100
	pie=cen/30.48
	pul=cen/2.54
	Escribir "Los resultados de las conversiones del valor en centimetros de ",cen
	Escribir "En metros es: ",me
	Escribir "En pies es: ",pie
	Escribir "En pulgadas es: ",pul
	Escribir "En yardas es: ",yar
FinAlgoritmo
