Algoritmo operacionesAlgoritmos
	Definir x, seno, coseno, tangente, ra, logNat, log10 Como Real
	Escribir "Ingrese el número a operar"
	Leer x
	seno=sen(x)
	coseno=cos(x)
	tangente=tan(x)
	ra=raiz(x)
	logNat=ln(x)
	log10=ln(x)/ln(10)
	Escribir "El seno de ",x " es: ",seno
	Escribir "El coseno de ",x " es: ",coseno
	Escribir "La tangente de ",x " es: ",tangente
	Escribir "La raiz de ",x " es: ",ra
	Escribir "El logaritmo natural de ",x " es: ",logNat
	Escribir "El logaritmo base 10 de ",x " es: ",log10
FinAlgoritmo
