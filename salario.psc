Algoritmo salario
	Definir valorHoras, salarioPagar Como Real
	Definir numeroHoras Como Entero
	Escribir "Programa para calcular el salario a pagar para un empleado"
	Escribir "Ingrese el valor a pagar por hora"
	Leer numeroHoras
	Escribir "Ingrese la cantidad de horas trabajadas por el trabajador"
	Leer valorHoras
	salarioPagar = valorHoras*numeroHoras
	Escribir "El valor a pagar del empleado es: $",salarioPagar 
FinAlgoritmo
